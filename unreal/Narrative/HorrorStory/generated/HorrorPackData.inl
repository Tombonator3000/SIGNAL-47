ellerstemme."}],"choices":[],"on_complete":{"set_flags":{"hr_h07_escape_complete_presented":true},"give_documents":[]}}],"documents":[],"media":[],"strings":[]},{"module_id":"arrival","flags":{},"scenes":[{"id":"H08_BRIEF","phase":"field","channel":"phone","mode":"live","entry":"trigger","trigger_nb":"H08: P\u00e5 trygg plass: legg SARO-original og eget romnotat ved Hondo- og Site11-utskrifter. Hent bevart kopi ved sen ankomst. Sammenlign proveniens, uavhengige kanaler, klokker, faseorden og kommende spor. Startteksten vises ved navngitt handling p\u00e5 stedet, \u00e9n gang per relevant inngang.","requires":{"all":["ctx_hr_h08_ready"],"none":["hr_h08_recorded","hr_h08_brief_presented"]},"direction_nb":"Korte linjer med naturlige pauser. Ingen automatisk slutning utover det spilleren faktisk har kontrollert.","lines":[{"id":"H08_BRIEF_001","speaker":"WARD","text":"Hondo kept its power when you lost yours. Their paper is a local record. Do not put your outage on their chart.","delivery_nb":"Eksisterende vakthavende. M\u00e5 ikke sl\u00e5s sammen med Dale."},{"id":"H08_BRIEF_002","speaker":"WARD","text":"Site 11 took the second reading with the audio feed unplugged. Their transit still recorded it.","delivery_nb":"Eksisterende vakthavende. M\u00e5 ikke sl\u00e5s sammen med Dale."},{"id":"H08_BRIEF_003","speaker":"WARD","text":"Compare the times and the order. Then tell me what is observation and what is your explanation.","delivery_nb":"Eksisterende vakthavende. M\u00e5 ikke sl\u00e5s sammen med Dale."}],"choices":[],"on_complete":{"set_flags":{"hr_h08_brief_presented":true},"give_documents":[]}},{"id":"H08_CHECK","phase":"field","channel":"ui","mode":"live","entry":"trigger","trigger_nb":"H08: Hondo/Site11 beholder sine ulike lokale m\u00e5leverdier. Sammenlign med vanlig sendeplan og kontroller at lydmating var frakoblet ved Site11s kontroll. Like ord alene godkjennes ikke. Ring Ward og send presise begrensninger. Kravflagget m\u00e5 komme fra faktisk kontroll, aldri fra \u00e5 )S47HR")
TEXT(R"S47HR(\u00e5pne panelet. Varslingsgrunnlaget blir eksternt sikret som tre kilde-ID-er og f\u00f8rste grensetid, lest tilbake av Ward i datert logg. M\u00e5letabellene blir i dokumentene; ingen automatisk kopi av fotoarkivet.","requires":{"all":["ctx_hr_h08_ready","ctx_hr_h08_checked","ctx_hr_remote_sources_verified"],"none":["hr_h08_recorded"]},"direction_nb":"Korte linjer med naturlige pauser. Ingen automatisk slutning utover det spilleren faktisk har kontrollert.","lines":[{"id":"H08_CHECK_001","speaker":"DESCRIPTION","text":"The local source sheets agree on phase order and measured interval. Their separate optical readings show continuing approach.","delivery_nb":"Stille unders\u00f8kelsestekst, ingen fortellerstemme."},{"id":"H08_CHECK_002","speaker":"DESCRIPTION","text":"The warning can state coordinated preparation for an arrival. Identity and purpose remain unestablished. Call Ward and keep those limits on the report.","delivery_nb":"Stille unders\u00f8kelsestekst, ingen fortellerstemme."}],"choices":[],"on_complete":{"set_flags":{"hr_h08_recorded":true},"give_documents":[]}},{"id":"H08_INCOMPLETE","phase":"field","channel":"ui","mode":"live","entry":"trigger","trigger_nb":"H08: Manglende sanntidsmottak erstattes av bevart lokalt stempel/originalkopi p\u00e5 telex. Uverifisert kilde f\u00f8res som forel\u00f8pig og ringer Ward for kildekontroll; varsel om lokal fare kan sendes straks. Sterk nettverksslutning venter p\u00e5 de to uavhengige fjernkildene. Vis bare ved et faktisk utilstrekkelig resultat.","requires":{"all":["ctx_hr_h08_ready","ctx_hr_h08_insufficient"],"none":[]},"direction_nb":"Ingen feil-lyd eller skremmestikk. Bevar eksisterende funn og vis neste gjennomf\u00f8rbare handling. Settet markerer ikke oppdraget fullf\u00f8rt.","lines":[{"id":"H08_INCOMPLETE_001","speaker":"DESCRIPTION","text":"One remote source is not verified. Send the local warning now, then ask Ward for the original source sheet before recording a network conclusion.","delivery_nb":"Stille unders\u00f8kelsestekst, ingen fortellerstemme."}],"choices":[],"on_complete":{"set_flags":{},"give_documents":[]}},{"id":"H08_COMPARE_RECORDS","phase":"field","channel":"ui","mode":"live","entry":"trigger","trigger_nb":"Spilleren har faktisk samlet og sammenlignet alle tre lokale kilder og klokke-/kontrollark. Den komplette SARO-kilden krever faktisk lys-/reaksjonskontroll og gjennomf\u00f8rt flukt. F\u00f8r-angrepsbunten inneholder ikke disse ferdige observasjonene.","requires":{"all":["ctx_hr_remote_sources_verified","ctx_hr_h07_checked","ctx_hr_h07_escape_complete","ctx_hr_h07_original_secured","ctx_hr_h07_bundle_secured"],"none":[]},"direction_nb":"Korte linjer med naturlige pauser. Ingen automatisk slutning utover det spilleren faktisk har kontrollert.","lines":[{"id":"H08_COMPARE_RECORDS_001","speaker":"DESCRIPTION","text":"The source sheets contain different local readings. Their sequence and timing agree.","delivery_nb":"Stille unders\u00f8kelsestekst, ingen fortellerstemme."},{"id":"H08_COMPARE_RECORDS_002","speaker":"DESCRIPTION","text":"Hondo and Site 11 each recorded approaching tracks after the reference sweep. SARO is one prepared place among several.","delivery_nb":"Stille unders\u00f8kelsestekst, ingen fortellerstemme."},{"id":"H08_COMPARE_RECORDS_003","speaker":"DESCRIPTION","text":"The records support a warning about a coordinated arrival. They do not identify who is coming.","delivery_nb":"Stille unders\u00f8kelsestekst, ingen fortellerstemme."}],"choices":[],"on_complete":{"set_flags":{},"give_documents":["HR_SARO_ORIGINAL","HR_HONDO_LOCAL","HR_SITE11_LOCAL","HR_NETWORK_CHECK"]}},{"id":"H08_WARNING_ACK","phase":"field","channel":"phone","mode":"live","entry":"trigger","trigger_nb":"Kvittering f\u00f8rst n\u00e5r Ward faktisk er n\u00e5dd, Reyes har lest tre kilde-ID-er og f\u00f8rste grensetid, og Ward har lest dem tilbake og f\u00f8rt dem i datert logg. 06:00-serien er allerede stanset. Ikke et tilfeldig tidsutl\u00f8p; foto og negative blir hos spilleren.","requires":{"all":["ctx_hr_warning_acknowledged","ctx_hr_remote_sources_verified"],"none":["hr_h08_warning_ack_presented"]},"direction_nb":"Korte linjer med naturlige pauser. Ingen automatisk slutning utover det spilleren faktisk har kontrollert.","lines":[{"id":"H08_WARNING_ACK_001","speaker":"WARD","text":"The network warning is entered. The six o'clock series remains suspended after your earlier report. The other sites have read it back: nobody closes a reference or completes a run.","delivery_nb":"Eksisterende vakthavende. M\u00e5 ikke sl\u00e5s sammen med Dale."},{"id":"H08_WARNING_ACK_003","speaker":"WARD","text":"Reading back: SARO zero-seven original run, Hondo local sheet, Site Eleven local sheet. First boundary, oh-three-fifty-six and eight seconds. That is in my dated log. The warning is outside SARO; keep the photographs and originals with their sheets.","delivery_nb":"Eksisterende vakthavende. M\u00e5 ikke sl\u00e5s sammen med Dale."},{"id":"H08_WARNING_ACK_002","speaker":"WARD","text":"The field courier is on the old Roswell road, east of the mapped reference. Check the map at the diner before you agree a handover point.","delivery_nb":"Eksisterende vakthavende. M\u00e5 ikke sl\u00e5s sammen med Dale."}],"choices":[],"on_complete":{"set_flags":{"hr_h08_warning_ack_presented":true},"give_documents":["HR_WARNING_RECEIPT"]}},{"id":"H09_BRIEF","phase":"all_night","channel":"physical","mode":"live","entry":"trigger","trigger_nb":"H08 kartdel (tidligere H09): rolig diner etter kvittert varsel. Les E15, det innrammede utklippet fra juli 1947 som allerede henger ved d\u00f8ren. Legg E09A-tracingen p\u00e5 E14, transit p\u00e5 STATION 01 og nord mot nord. Behold P13 som reell kartoppgave. Dagens avis i byen er en annen, valgfri kilde. Startteksten vises ved navngitt handling p\u00e5 stedet, \u00e9n gang per relevant inngang.","requires":{"all":["ctx_hr_h09_ready","ctx_hr_warning_acknowledged"],"none":["hr_h09_recorded","hr_h09_brief_present)S47HR")
TEXT(R"S47HR(ed"]},"direction_nb":"Korte linjer med naturlige pauser. Ingen automatisk slutning utover det spilleren faktisk har kontrollert.","lines":[{"id":"H09_BRIEF_001","speaker":"DESCRIPTION","text":"The framed clipping by the door is the old one, July 1947. It is a photograph of a place, not a measurement.","delivery_nb":"Engelsk unders\u00f8kelsestekst. Ingen diegetisk forteller eller Kinski-opplesning i denne pakken."},{"id":"H09_BRIEF_002","speaker":"DESCRIPTION","text":"Ward has the warning. What is left is the map: where C meets the old road, and where the courier can wait beyond it.","delivery_nb":"Engelsk unders\u00f8kelsestekst. Ingen diegetisk forteller eller Kinski-opplesning i denne pakken."},{"id":"H09_BRIEF_003","speaker":"DESCRIPTION","text":"On the table the tracing is still loose. Place its transit on STATION 01, north to north. The framed newspaper clipping has no survey scale.","delivery_nb":"Stille unders\u00f8kelsestekst, ingen fortellerstemme."}],"choices":[],"on_complete":{"set_flags":{"hr_h09_brief_presented":true},"give_documents":[]}},{"id":"H09_CHECK","phase":"all_night","channel":"phone","mode":"live","entry":"trigger","trigger_nb":"H08 kartdel (tidligere H09): finn C ved 8.15-bolten og avtal separat 10.4-bolt med Ward. Sheriffbetjentens patruljeark er \u00e9n kj\u00f8retur, ikke et generelt trygghetsbevis. Kravflagget m\u00e5 komme fra faktisk kontroll, aldri fra \u00e5 \u00e5pne panelet.","requires":{"all":["ctx_hr_h09_ready","ctx_hr_h09_checked","ctx_hr_warning_acknowledged","ctx_hr_sc12_courier_104_confirmed"],"none":["hr_h09_recorded"]},"direction_nb":"Korte linjer med naturlige pauser. Ingen automatisk slutning utover det spilleren faktisk har kontrollert.","lines":[{"id":"H09_CHECK_001","speaker":"WARD","text":"C is the bolt at eight point one five. The handover is ten point four. I have both marked.","delivery_nb":"Eksisterende vakthavende. M\u00e5 ikke sl\u00e5s sammen med Dale."},{"id":"H09_CHECK_002","speaker":"WARD","text":"The old road is the direct approach to the courier. It is a practical route, not a finding that the reference is safe.","delivery_nb":"Eksisterende vakthavende. M\u00e5 ikke sl\u00e5s sammen med Dale."},{"id":"H09_CHECK_003","speaker":"WARD","text":"Take the originals through. Stay in the cab, keep moving and take no reading at the bolt. If the truck falters before the crossing, turn back while you can.","delivery_nb":"Eksisterende vakthavende. M\u00e5 ikke sl\u00e5s sammen med Dale."}],"choices":[],"on_complete":{"set_flags":{"hr_h09_recorded":true},"give_documents":[]}},{"id":"H09_INCOMPLETE","phase":"all_night","channel":"ui","mode":"live","entry":"trigger","trigger_nb":"H08 kartdel (tidligere H09): E15 er et gammelt, tilgjengelig dinerutklipp og skal ikke ha 04:45-port. Leveringsregelen gjelder dagens avis i byen. Feil kartplassering f\u00e5r eksisterende karttips; bildet l\u00f8ser ikke C alene. Hvis varsling mangler, gi konkret telefonhandling f\u00f8r avreise. Vis bare ved et faktisk utilstrekkelig resultat.","requires":{"all":["ctx_hr_h09_ready","ctx_hr_h09_insufficient"],"none":[]},"direction_nb":"Ingen feil-lyd eller skremmestikk. Bevar eksisterende funn og vis neste gjennomf\u00f8rbare handling. Settet markerer ikke oppdraget fullf\u00f8rt.","lines":[{"id":"H09_INCOMPLETE_001","speaker":"DESCRIPTION","text":"C is not placed yet. Put the transit on STATION 01 first. Keep the old framed clipping beside the map; it establishes the photograph, not the crossing.","delivery_nb":"Stille unders\u00f8kelsestekst, ingen fortellerstemme."}],"choices":[],"on_complete":{"set_flags":{},"give_documents":[]}},{"id":"H10_BRIEF","phase":"all_night","channel":"ui","mode":"live","entry":"trigger","trigger_nb":"H10: G\u00e5 til servicebilen og velg tydelig overleveringsoppdrag. Spillet lagrer et sikkert punkt ved avreise. Kj\u00f8r den eksisterende veien fra dinerens mile 0 mot det avtalte 10.4-punktet, forbi C ved 8.15 uten planlagt stopp. 10.4 vises bare p\u00e5 kart og skilt; finalen ved C avbryter reisen. Varsling er allerede levert. Startteksten vises ved navngitt handling p\u00e5 stedet, \u00e9n gang per relevant inngang.","requires":{"all":["ctx_hr_h10_ready","ctx_hr_warning_acknowledged","ctx_hr_sc12_patrol_sheet_read","ctx_hr_sc12_courier_104_confirmed"],"none":["hr_h10_recorded","hr_h10_brief_presented"]},"direction_nb":"Korte linjer med naturlige pauser. Ingen automatisk slutning utover det spilleren faktisk har kontrollert.","lines":[{"id":"H10_BRIEF_001","speaker":"DESCRIPTION","text":"The originals are in the cab. Ward has the warning, the three source IDs and the first boundary time.","delivery_nb":"Stille unders\u00f8kelsestekst, ingen fortellerstemme."},{"id":"H10_BRIEF_002","speaker":"DESCRIPTION","text":"Handover: mile 10.4. C: mile 8.15. Pass the reference without stopping or taking a reading.","delivery_nb":"Stille unders\u00f8kelsestekst, ingen fortellerstemme."},{"id":"H10_BRIEF_003","speaker":"DESCRIPTION","text":"Leave for the handover when you are ready.","delivery_nb":"Stille unders\u00f8kelsestekst, ingen fortellerstemme."}],"choices":[],"on_complete":{"set_flags":{"hr_h10_brief_presented":true},"give_documents":[]}},{"id":"H10_CHECK","phase":"all_night","channel":"ui","mode":"live","entry":"trigger","trigger_nb":"H10: F\u00f8r avreise bekreft at originalene er med, at Ward har kvittert og at C og overleveringspunkt er forskjellige. Ikke lag en ny parkerings-/avlesningsoppgave ved C. Kravflagget m\u00e5 komme fra faktisk kontroll, aldri fra \u00e5 \u00e5pne panelet.","requires":{"all":["ctx_hr_h10_ready","ctx_hr_h10_checked","ctx_hr_h10_stalled"],"none":["hr_h10_recorded"]},"direction_nb":"Korte linjer med naturlige pauser. Ingen automatisk slutning utover det spilleren faktisk har kontrollert.","lines":[{"id":"H10_CHECK_001","speaker":"DESCRIPTION","text":"At the crossing the engine stops. You did not turn the key off.","delivery_nb":"Stille unders\u00f8kelsestekst, ingen fortellerstemme."},{"id":"H10_CHECK_002","spe)S47HR")
TEXT(R"S47HR(aker":"DESCRIPTION","text":"The warning has already gone through. The originals are beside you.","delivery_nb":"Stille unders\u00f8kelsestekst, ingen fortellerstemme."}],"choices":[],"on_complete":{"set_flags":{"hr_h10_recorded":true},"give_documents":[]}},{"id":"H10_INCOMPLETE","phase":"all_night","channel":"ui","mode":"live","entry":"trigger","trigger_nb":"H10: Uferdig kart eller ukvittert varsel sender spilleren tilbake til den konkrete handlingen f\u00f8r avreise. Under finalen tilbys ingen falsk redningsgren eller skyldtekst. Vanlig Continue starter ved det tydelig oppgitte sikre sjekkpunktet. Vis bare ved et faktisk utilstrekkelig resultat.","requires":{"all":["ctx_hr_h10_ready","ctx_hr_h10_insufficient"],"none":[]},"direction_nb":"Ingen feil-lyd eller skremmestikk. Bevar eksisterende funn og vis neste gjennomf\u00f8rbare handling. Settet markerer ikke oppdraget fullf\u00f8rt.","lines":[{"id":"H10_INCOMPLETE_001","speaker":"DESCRIPTION","text":"The warning has not been acknowledged. Use the diner payphone before leaving.","delivery_nb":"Stille unders\u00f8kelsestekst, ingen fortellerstemme."}],"choices":[],"on_complete":{"set_flags":{},"give_documents":[]}}],"documents":[{"id":"HR_SARO_ORIGINAL","title":"SARO / original run and incident note","kind":"typed","stamp":"14 APR 1986 / LOCAL RECORD","body":["LOCAL SOURCE / SARO 07. Keep the original receiver record with the separate room-observation sheet. The room observation was written here; it was not received over the network.","The outside band crossed successive windows. The local lamp control did not remove it. An opaque screen interrupted it at the wall.","A visitor reacted to a new radio sound, as in the earlier encounter. Here the outside band moved across the exits in step with the visitor's search. The retained fragment continued unchanged. The new observation concerns coordination, not the first presence of a responsive visitor."],"production_nb":"Ny forfatterkilde, ikke eksisterende runtimebevis. Dato/tid og m\u00e5leverdier m\u00e5 bindes til faktisk hendelse i senere adapter. Dokumentet tildeles bare etter den fysiske handlingen; manglende fil godkjennes ikke som foto. F\u00f8r angrepet finnes bare mottakeroriginal og tomt/p\u00e5begynt hendelsesark. Denne sammensatte kilden tildeles f\u00f8rst etter faktisk lyskontroll, reaktivt m\u00f8te og flukt."},{"id":"HR_HONDO_LOCAL","title":"Hondo / local record","kind":"typed","stamp":"14 APR 1986 / LOCAL RECORD","body":["LOCAL SOURCE / HONDO. Copied from Hondo's battery-backed event logger and the operator's separate optical sheet. This is not the SARO telex forwarded back.","Power remained available during the earlier SARO blackout. During the later inspection cycle our local supply and the outside band changed independently.","LOCAL SHEET / reference passes: 03:56:08 R1; 03:56:55 R2; 03:57:42 R3. R1, R2 and R3 are Hondo's surveyed bearings. They are not a copied SARO azimuth setting.","PAIRED OPTICAL HEADS / surveyed baseline 480 m. At 04:00:00, local triangulated slant ranges: track H-A 18.4 km, H-B 21.1 km. At 04:00:30: H-A 18.3 km, H-B 21.0 km. At 04:01:00: H-A 18.2 km, H-B 20.9 km. Range uncertainty per reading: 0.04 km. The closing trend exceeds the measurement uncertainty over the full interval.","Our optical recorder shows the band returning to three surveyed bearings in the same order. After the third pass, two separate tracks entered the recorded approach sector. Their angular separation changed; they are not a still photograph or a repeated radio trace.","Observation interval: 03:56:00 to 04:04:00 MST, 14 APR 1986. Clock check against the time service before and after: within one second. Optical-sheet readings retained with the original. Identity unknown."],"production_nb":"Ny forfatterkilde, ikke eksisterende runtimebevis. Dato/tid og m\u00e5leverdier m\u00e5 bindes til faktisk hendelse i senere adapter. Dokumentet tildeles bare etter den fysiske handlingen; manglende fil godkjennes ikke som foto. De numeriske fjernm\u00e5lingene er ny fiktiv forfatterkilde. Ikke hent dem fra en faktisk test, gamle telex eller gjenta dem som m\u00e5lt spillbevis. Produser to separate kildeark med lokal skisse og r\u00e5verdier; paired-head oppsett er nytt fjernstasjonsgrunnlag, ikke eksisterende SARO-utstyr."},{"id":"HR_SITE11_LOCAL","title":"Site 11 / local record","kind":"typed","stamp":"14 APR 1986 / LOCAL RECORD","body":["LOCAL SOURCE / SITE 11. Local receiver chart plus independently clocked transit observations. Receiver was disconnected from the intersite audio feed during the second observation.","Three reference bearings were occupied in sequence. Two incoming tracks were then observed in the measured approach sector. Successive local readings show continued approach. The two tracks held their order while the reference cycle advanced.","LOCAL SHEET / reference passes: 03:56:08 R1; 03:56:56 R2; 03:57:42 R3. These labels refer to Site 11's own survey diagram. The middle boundary differs by one second, within the checked clocks; do not erase that difference.","PAIRED OPTICAL HEADS / surveyed baseline 620 m. At 04:00:00, local triangulated slant ranges: track S-A 22.6 km, S-B 24.0 km. At 04:00:30: S-A 22.5 km, S-B 23.9 km. At 04:01:00: S-A 22.4 km, S-B 23.8 km. Range uncertainty per reading: 0.04 km. Directions differ from Hondo's local observations. Identity unknown; no predicted arrival minute entered.","Observation interval: 03:56:00 to 04:04:00 MST, 14 APR 1986. Clock check before and after: within one second. The receiver trace alone cannot establish an approach; the transit readings are a separate observation.","The sequence boundaries agree with Hondo to the resolution of the local clocks. The approach measurements differ by station, as separate locations should. The instruments were not running an agreed survey sequence."],"production_nb":"Ny forfatterkilde, ikke eksisterende runtimebevis. Dato/tid og m\u00e5leverdier m\u00e5 bindes til faktisk hendelse i senere adapte)S47HR")
TEXT(R"S47HR(r. Dokumentet tildeles bare etter den fysiske handlingen; manglende fil godkjennes ikke som foto. De numeriske fjernm\u00e5lingene er ny fiktiv forfatterkilde. Ikke hent dem fra en faktisk test, gamle telex eller gjenta dem som m\u00e5lt spillbevis. Produser to separate kildeark med lokal skisse og r\u00e5verdier; paired-head oppsett er nytt fjernstasjonsgrunnlag, ikke eksisterende SARO-utstyr."},{"id":"HR_NETWORK_CHECK","title":"Source check / three local records","kind":"typed","stamp":"14 APR 1986 / LOCAL RECORD","body":["SARO: room observation and original receiver run. Hondo: local event logger and optical record. Site 11: local receiver and transit sheet with the intersite audio feed disconnected.","The ordinary radio programme explains none of the optical changes. Matching words on a radio would establish only a shared recording; these records contain different local measurements.","The same ordered reference cycle occurs at separated sites during the same measured interval. Two stations independently record continuing incoming tracks after that cycle. A coordinated preparation for an arrival is the supported working warning. Identity and purpose remain unknown."],"production_nb":"Ny forfatterkilde, ikke eksisterende runtimebevis. Dato/tid og m\u00e5leverdier m\u00e5 bindes til faktisk hendelse i senere adapter. Dokumentet tildeles bare etter den fysiske handlingen; manglende fil godkjennes ikke som foto."},{"id":"HR_WARNING_RECEIPT","title":"Ward / warning and suspension receipt","kind":"typed","stamp":"14 APR 1986 / LOCAL RECORD","body":["RECEIVED / E. WARD. SARO original identified; local observations separated from receiver copy. Hondo and Site 11 originals requested and their source checks retained.","The 06:00 morning series remains suspended after the earlier local safety report. No fresh observer is to close a reference or complete the old run. Other sites have now acknowledged the same instruction. This does not claim that the external activity has stopped.","The warning, three source IDs and the first boundary time (03:56:08) are read back and retained in Ward's dated call log outside SARO. The measurement tables, photographs, negatives and complete source sheets remain in the transfer folder. The courier has the field map. A handover point is to be agreed after the diner map and current route checks; this receipt does not confirm one.","Time of acknowledgement is entered when this call is actually completed. Do not preprint a successful acknowledgement before the line has been answered."],"production_nb":"Ny forfatterkilde, ikke eksisterende runtimebevis. Dato/tid og m\u00e5leverdier m\u00e5 bindes til faktisk hendelse i senere adapter. Dokumentet tildeles bare etter den fysiske handlingen; manglende fil godkjennes ikke som foto."}],"media":[],"strings":[]},{"module_id":"unified_scenarios","flags":{"hr_sc01_window_check_presented":{"default":false,"purpose_nb":"Presentert forfattertekst etter faktiske verdensporter. Ingen fysisk m\u00e5ling, flukt eller global progresjonsport."},"hr_sc01_first_report_presented":{"default":false,"purpose_nb":"Presentert forfattertekst etter faktiske verdensporter. Ingen fysisk m\u00e5ling, flukt eller global progresjonsport."},"hr_sc02_return_warning_presented":{"default":false,"purpose_nb":"Presentert forfattertekst etter faktiske verdensporter. Ingen fysisk m\u00e5ling, flukt eller global progresjonsport."},"hr_sc02_escape_presented":{"default":false,"purpose_nb":"Presentert forfattertekst etter faktiske verdensporter. Ingen fysisk m\u00e5ling, flukt eller global progresjonsport."},"hr_sc03_dispatch_receipt_presented":{"default":false,"purpose_nb":"Presentert forfattertekst etter faktiske verdensporter. Ingen fysisk m\u00e5ling, flukt eller global progresjonsport."},"hr_sc03_relief_contact_presented":{"default":false,"purpose_nb":"Presentert forfattertekst etter faktiske verdensporter. Ingen fysisk m\u00e5ling, flukt eller global progresjonsport."},"hr_sc03_ortiz_identify_presented":{"default":false,"purpose_nb":"Presentert forfattertekst etter faktiske verdensporter. Ingen fysisk m\u00e5ling, flukt eller global progresjonsport."},"hr_sc03_helper_taken_presented":{"default":false,"purpose_nb":"Presentert forfattertekst etter faktiske verdensporter. Ingen fysisk m\u00e5ling, flukt eller global progresjonsport."},"hr_sc03_helper_traces_presented":{"default":false,"purpose_nb":"Presentert forfattertekst etter faktiske verdensporter. Ingen fysisk m\u00e5ling, flukt eller global progresjonsport."},"hr_sc03_missing_receipt_presented":{"default":false,"purpose_nb":"Presentert forfattertekst etter faktiske verdensporter. Ingen fysisk m\u00e5ling, flukt eller global progresjonsport."},"hr_sc03_local_order_hold_presented":{"default":false,"purpose_nb":"Presentert forfattertekst etter faktiske verdensporter. Ingen fysisk m\u00e5ling, flukt eller global progresjonsport."},"hr_sc03_receiver_question_presented":{"default":false,"purpose_nb":"Presentert forfattertekst etter faktiske verdensporter. Ingen fysisk m\u00e5ling, flukt eller global progresjonsport."},"hr_sc04_limited_return_presented":{"default":false,"purpose_nb":"Presentert forfattertekst etter faktiske verdensporter. Ingen fysisk m\u00e5ling, flukt eller global progresjonsport."},"hr_sc04_local_hold_presented":{"default":false,"purpose_nb":"Presentert forfattertekst etter faktiske verdensporter. Ingen fysisk m\u00e5ling, flukt eller global progresjonsport."},"hr_sc04_annex_imprint_presented":{"default":false,"purpose_nb":"Presentert forfattertekst etter faktiske verdensporter. Ingen fysisk m\u00e5ling, flukt eller global progresjonsport."},"hr_sc04_annex_long_escape_presented":{"default":false,"purpose_nb":"Presentert forfattertekst etter faktiske verdensporter. Ingen fysisk m\u00e5ling, flukt eller global progresjonsport."},"hr_sc04_annex_sound_escape_presented":{"default":false,"purpose_nb":"Presentert forfattertekst etter faktiske verdensporter. Ingen fysisk m\u00e5ling, 