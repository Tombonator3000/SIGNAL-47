          "speech_end_seconds": 6.2,
          "reuse_of": null
        },
        {
          "id": "H01_BRIEF_002",
          "text": "The camera is beside the east door. Take a reference before you touch the fault.",
          "voice": "dale",
          "file": "H01_BRIEF_002.wav",
          "asset": "v_H01_BRIEF_002",
          "raw": "voice/horror/H01_BRIEF_002.wav",
          "duration": 4.07,
          "frames": 195360,
