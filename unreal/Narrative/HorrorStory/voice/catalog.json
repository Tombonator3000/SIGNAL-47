          "speech_start_seconds": 0.08,
          "speech_end_seconds": 3.89,
          "reuse_of": null
        },
        {
          "id": "H01_BRIEF_003",
          "text": "And try your way out while the lights are good. A door on a plan is no use if you have never opened it.",
          "voice": "dale",
          "file": "H01_BRIEF_003.wav",
          "asset": "v_H01_BRIEF_003",
          "raw": "voice/horror/H01_BRIEF_003.wav",
