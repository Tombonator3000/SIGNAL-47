          "speech_start_seconds": 0.08,
          "speech_end_seconds": 4.21,
          "reuse_of": null
        },
        {
          "id": "H04_BRIEF_003",
          "text": "I saw the same shape from two places. I do not know whether it was looking at me.",
          "voice": "dale",
          "file": "H04_BRIEF_003.wav",
          "asset": "v_H04_BRIEF_003",
