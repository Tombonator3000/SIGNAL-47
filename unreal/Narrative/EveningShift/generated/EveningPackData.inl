TEXT(R"S47EV(e kontroller, med faktisk lysforl\u00f8p synlig.","requires":{"all":["ctx_trafo_isolation_verified","ctx_trafo_backup_excluded","ctx_trafo_indicator_checked","ctx_trafo_lamp_persists","ctx_trafo_photo_available"],"none":[]},"direction_nb":"Vis som kort unders\u00f8kelsestekst uten fortellerstemme. G\u00e5 tilbake til samme fysiske oppgave etterp\u00e5.","lines":[{"id":"T02_VERIFIED_001","speaker":"DESCRIPTION","text":"The local isolation result is recorded. The checked backup does not account for the light. The indicator has been compared with the independent service check.","delivery_nb":"Ingen innspilt stemme. Tekst p\u00e5 panelet eller i notatboken."},{"id":"T02_VERIFIED_002","speaker":"DESCRIPTION","text":"The marked light continues its visible sequence.","delivery_nb":"Ingen innspilt stemme. Tekst p\u00e5 panelet eller i notatboken."},{"id":"T02_VERIFIED_003","speaker":"DESCRIPTION","text":"Observation filed: under these controls, the light and the service result disagree. Cause unknown.","delivery_nb":"Ingen innspilt stemme. Tekst p\u00e5 panelet eller i notatboken."}],"choices":[],"on_complete":{"set_flags":{"trafo_anomaly_checked":true},"give_documents":["EV_TRAFO_FOLLOWUP"]}},{"id":"T02_UNRESOLVED","phase":"field","channel":"ui","mode":"live","entry":"choice","trigger_nb":"Avslutt panelet uten \u00e5 fabrikere et bekreftet avvik. Hovedhistoriens STATION 01-/Nora-rute er fortsatt tilgjengelig.","requires":{"all":[],"none":[]},"direction_nb":"Vis som kort unders\u00f8kelsestekst uten fortellerstemme. G\u00e5 tilbake til samme fysiske oppgave etterp\u00e5.","lines":[{"id":"T02_UNRESOLVED_001","speaker":"DESCRIPTION","text":"Unresolved. The reference is useful, but the current supply and the visible light have not yet been accounted for together.","delivery_nb":"Ingen innspilt stemme. Tekst p\u00e5 panelet eller i notatboken."},{"id":"T02_UNRESOLVED_002","speaker":"DESCRIPTION","text":"Keep the reference and your checks. An unanswered observation 