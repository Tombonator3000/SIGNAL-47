:["EV_DALE_UNSENT"]}},{"id":"D02_NIGHT_READ_UNSENT","phase":"all_night","channel":"physical","mode":"live","entry":"trigger","trigger_nb":"Kun vertens faktisk \u00e5pnete kontordokument EV_DALE_UNSENT kan kvittere denne handlingen; ikke ved mappe-/meny\u00e5pning.","requires":{"all":["office_open"],"none":["office_unsent_read"]},"direction_nb":"Stille fysisk tekst, ingen forteller. Egen leststatus uten hovedport, VHS-kvittering eller fullf\u00f8rt feltpr\u00f8ve.","lines":[],"choices":[],"on_complete":{"set_flags":{"office_unsent_read":true},"give_documents":["EV_DALE_UNSENT"]}},{"id":"D02_READ_ARRAY_SERVICE","phase":"archive","channel":"physical","mode":"live","entry":"trigger","trigger_nb":"Kun vertens faktisk \u00e5pnete kontordokument EV_DALE_ARRAY_SERVICE kan kvittere denne handlingen; ikke ved mappe-/meny\u00e5pning.","requires":{"all":["office_open"],"none":["office_array_service_read"]},"direction_nb":"Stille fysisk tekst, ingen forteller. Egen leststatus uten hovedport, VHS-kvittering eller fullf\u00f8rt feltpr\u00f8ve.","lines":[],"choices":[],"on_complete":{"set_flags":{"office_array_service_read":true},"give_documents":["EV_DALE_ARRAY_SERVICE"]}},{"id":"D02_FIELD_READ_ARRAY_SERVICE","phase":"field","channel":"physical","mode":"live","entry":"trigger","trigger_nb":"Kun vertens faktisk \u00e5pnete kontordokument EV_DALE_ARRAY_SERVICE kan kvittere denne handlingen; ikke ved mappe-/meny\u00e5pning.","requires":{"all":["office_open"],"none":["office_array_service_read"]},"direction_nb":"Stille fysisk tekst, ingen forteller. Egen leststatus uten hovedport, VHS-kvittering eller fullf\u00f8rt feltpr\u00f8ve.","lines":[],"choices":[],"on_complete":{"set_flags":{"office_array_service_read":true},"give_documents":["EV_DALE_ARRAY_SERVICE"]}},{"id":"D02_NIGHT_READ_ARRAY_SERVICE","phase":"all_night","channel":"physical","mode":"live","entry":"trigger","trigger_nb":"Kun vertens faktisk \u00e5pnete kontordokument EV_DALE_ARRAY_SERVICE kan kvittere denne handlingen; ikke ved mappe-/meny\u00e5pning.","requires":{"all":["office_open"],"none":["office_array_service_read"]},"direction_nb":"Stille fysisk tekst, ingen forteller. Egen leststatus uten hovedport, VHS-kvittering eller fullf\u00f8rt feltpr\u00f8ve.","lines":[],"choices":[],"on_complete":{"set_flags":{"office_array_service_read":true},"give_documents":["EV_DALE_ARRAY_SERVICE"]}}],"documents":[{"id":"EV_HANDOVER","title":"Evening handover / Sunday, April 13","kind":"typed","stamp":"SARO / OPERATIONS / 13 APR 1986","body":["18:00 HANDOVER\nEvening operator: Reyes. Duty officer: Ward. Field maintenance contact: Dale, by telephone or service radio.","Carry out the ordinary room checks before starting the survey. There are 27 antennas on the installation list. The azimuth reference card remains 026. Record what the instruments say; do not adjust a reading simply to make it agree with the card.","The local service log and radio transmission schedule are in this handover folder. The day operator collected the copies. Keep them in the shift file. If an entry needs checking later, the service desk and station window in Caliche can help; there is no need to go down just to collect the same papers.","If the feeder complaint repeats, take the service-road route to the substation and use the marked inspection position. Follow the local isolation card. Do not enter the switching yard or work on exposed conductors.","Operations spare: service drawer at the workbench. Please put it back when you have finished. The office latch needs lifting. Milk is in the small refrigerator. Leave the receipt with petty cash."],"production_nb":"Ordin\u00e6r overlevering ved skiftstart 18:00, lenge f\u00f8r ny residual. D01_BRIEF gir EV_HANDOVER, EV_SERVICE_LOG og EV_RADIO_SCHEDULE fra mappen p\u00e5 SARO. Byvinduene er valgfrie oppf\u00f8lginger og alternative kilder, ikke p\u00e5lagt henteoppdrag. Dale er bare tilgjengelig via telefon/radio/walkie; Ward er egen vakthavende. Utstyrs- og K3-regler f\u00f8lger eksisterende)S47EV")
TEXT(R"S47EV( spillkontrakt."},{"id":"EV_SERVICE_LOG","title":"Caliche service log / released copy","kind":"typed","stamp":"LOCAL SERVICE DESK / 13 APR 1986","body":["SERVICE COPY\nPrepared Sunday, April 13, 1986. Collected for SARO by the day operator; enclosed with the evening handover. Entries below are civil time as entered by the attendant; they are not precision timing records.","April 12, 19:06. Complaint: exterior lamp on service-road inspection circuit dimming intermittently. Other premises reported normal supply. No town-wide interruption entered.","April 13, 16:40. Maintenance inspection requested. Complaint remains open until the local test is completed and the result entered on the inspection card.","Supply labels and the inspection-circuit identifier must be read at the marked service panel. A lamp lighting does not by itself prove which supply is carrying it. Compare the panel indication with the permitted local test and the actual lamp.","No entry in this book means no report was entered here. It does not establish that every circuit remained live. Retain this copy if a later occurrence needs to be compared with the service record.","RELEASED COPY. Keep the original at the service desk. Later entries must be dated separately; do not add them to this sheet."],"production_nb":"Ny ordin\u00e6r kveldsreferanse i Dales overleveringsmappe p\u00e5 SARO. Dagens dagoperat\u00f8r har hentet kopien; spilleren hentet den ikke p\u00e5 matstoppet. Tidligere lokal feil kan pr\u00f8ves i T01 og sammenlignes senere, men verken den feilen eller manglende nye journaloppf\u00f8ringer beviser \u00e5rsak til residualen eller forsyningstilstanden i hele byen 00:13. Bruk egen inspeksjonskontroll for T01/T02; ingen reelle h\u00f8yspenningsinstrukser og ingen kobling fra SAROs K3 til bynettet."},{"id":"EV_RADIO_SCHEDULE","title":"1420 AM / transmission schedule","kind":"typed","stamp":"PUBLIC COPY / SUNDAY 13 APRIL 1986","body":["1420 AM / LOCAL TRANSMISSION SCHEDULE\nSunday, April 13 into Monday, April 14. Station clock. Programs may be interrupted for local bulletins.","18:00\u201320:00. Evening records, weather and local notices. Evening staff on duty. Public copies and messages at the station window.","20:00\u201300:00. Music service. Recorded segments and local continuity. The person at the window may be covering other duties; leave a message if it is unattended.","00:00\u201304:00 MONDAY. THE NIGHT LINE / EARL. Telephone calls and local reports. An open microphone or ON AIR lamp does not establish that any particular caller was connected.","04:00. Night Line ends. Transmitter service and the scheduled morning program follow. An empty studio after four is normal; consult the actual program log for interruptions or changes.","This is a schedule, not proof of what was transmitted. For a disputed item, keep the date and approximate time and request the corresponding log entry or preserved program segment.","The station is an AM broadcast service. This sheet is not a tuning instruction for observatory equipment."],"production_nb":"Fysisk kveldskopi som dagoperat\u00f8ren allerede har hentet, vedlagt Dales overleveringsmappe p\u00e5 SARO. Stasjonsvinduet er en valgfri senere kilde til supplerende materiale; ingen obligatorisk hentetur. Earl arbeider bare 00\u201304; kveldens innhold og bemanning er egne roller. Adapteren m\u00e5 synkronisere vindu, ON AIR og faktisk lyd. Sendeskjemaet dokumenterer planlagt normaldrift, ikke hva som faktisk ble sendt rundt residualen."},{"id":"EV_DALE_INDEX","title":"Field checks / working index","kind":"hand","stamp":"DALE / WORKING COPY / 13 APR","body":["FIELD CHECKS\nNot a report. Keep this with the maintenance forms. Some of these are ordinary faults. Some may be bad recordings.","1. SERVICE ROAD / FIELD 01. VHS cassette in the desk unit. Environment sound only. The middle section contains the movement I could not account for. The recording date on the camera was not set correctly. Do not use it to establish a date or an exact time.","2. CAMERA POSITION. Outside the substation fence. Low concrete culvert beside the service gate. Stand on the road side of the post with two white bands. Face the nearest pole so the two outer conductors and the top of the pole remain in frame. The fence corner should sit at the lower left.","3. COMPARISON. First inspect the ordinary supply indication and the permitted lamp test. Return to the same position. Compare the nearest pole, the two outer conductors and the moving patch separately. Do not use camera shake as movement in the scene.","4. LIMIT. The cassette cannot establish what supplied the lamp or whether the shape was in the air. It does establish where the camera stood. A fresh observation from that position would be more useful than another opinion about the tape.","5. BACKGROUND. Two newspaper cuttings and a service note. Dates uncertain on one clipping. These are leads, not a map to a destination. The survey-station papers belong to their own file.","Leave the originals here. Take this copy if you go out. Tell Ward where you are going."],"production_nb":"Kort hovedspor som kan tas uten full VHS eller \u00f8vrig fordypning. T02 m\u00e5 bygge n\u00f8yaktig gjenkjennelig kulvert, to hvite b\u00e5nd, stolpe, lederpar og gjerdehj\u00f8rne som filmen viser. Gjenbruk ikke STATION 01-identitet eller C-kryss. Klippets dato er usikker med vilje og kan ikke brukes som fullf\u00f8rt tidsbevis."},{"id":"EV_DALE_CLIPPINGS","title":"Local cuttings / dates to check","kind":"hand","stamp":"FIELD CHECKS / BACKGROUND","body":["CUTTING A\nPECOS VALLEY SENTINEL / OCTOBER 22, 1985\nDRIVERS REPORT STALLED ENGINES ON COUNTY ROAD","Two motorists reported brief electrical failures on a county road east of the highway over the weekend. Both vehicles restarted. A county spokesman said no general supply interruption had been reported. No cause was entered in the notice.","Dale, pencil: Cars are not supplied by the town feeder. Same evening is not the same ca)S47EV")
TEXT(R"S47EV(use. Ask for a location before putting this beside the service complaint.","CUTTING B\nHEADLINE SAVED; DATE MISSING\nRANCHER FINDS FENCE LAMP BURNING AFTER LINE FAULT","The lamp had an auxiliary supply. The owner said the indicator had shown the main line was disconnected. The remainder of the item is missing.","Dale, pencil: Ordinary explanation. Keep it. A lit lamp is not evidence that a disconnected line is live. Need the whole page and the maintenance entry.","In the empty space below: I have two accounts of a movement near the service road. Neither witness agrees on the date. Do not make a pattern out of that yet."],"production_nb":"Nye fiktive diegetiske utklipp skrevet for denne pakken, ikke ekte avisgjengivelse. Ingen koordinater eller \u00e5ttemilsreferanse som l\u00f8ser P13. Dales merknader avgrenser kunnskap og tilbyr vanlig forklaring; ingen bredere 1947-fotografi eller sluttspoiler."},{"id":"EV_DALE_CONTACT","title":"Field contact / keep with the radio","kind":"typed","stamp":"OPERATIONS / CONTACT CARD","body":["FIELD MAINTENANCE CONTACT: DALE\nUse the SARO service telephone or the marked service-radio channel. Ask the operator for Dale / field maintenance. If the line is busy, leave the place you are calling from and the circuit label you copied.","Keep the installation name, your position and the observation separate. Say what changed, what stayed still and what control you used. An uncertain reading is useful if you say it is uncertain.","If there is an immediate service problem, notify Ward, the duty officer, first. This card does not authorize switching or entry to a locked electrical yard.","Handwritten addition: I may be on another line. Keep your note. Do not wait beside the gate just to get me on the radio. \u2014 D."],"production_nb":"Kortet gir kontaktinstruks, ikke ny oppdiktet tallfrekvens eller et telefonnummer som ikke finnes i spillet. Integrasjon m\u00e5 gi egne konkrete oppringings-/walkiehandlinger i egnet modul. Ingen fysisk Dale. Kan beholdes uten \u00e5 utl\u00f8se samtale eller blokkere hovedreise."},{"id":"EV_DALE_NOTE","title":"A note beneath the inspection sheets","kind":"hand","stamp":"DALE / UNSENT WORKING NOTE","body":["I started this folder because the service complaint kept coming back under different names. Weak lamp. Bad connection. Somebody seeing a shape out by the wire. It is tempting to put them all in the same box.","The first two have ordinary tests. The third may be a camera fault. I have watched that tape enough times to start anticipating the movement. That is not the same as understanding it.","I marked the camera position because it is the one thing I could check afterwards. The culvert, the two white bands and the nearest pole are still there. Stand there before making a copy of my conclusion. I have not made one.","On the recording the lamp is visible. You cannot tell from the picture which supply feeds it. Check that before treating the lamp as a contradiction. Keep the actual supply test and the movement on the tape as separate observations.","I have put copies of the local notices behind this page. There may be something worth comparing in the old survey papers, but I have not established a connection. Similar words in two accounts are a reason to check the originals, not permission to fill the gap.","If you take the sheet, leave me a note. If I am not on the telephone, try the service radio. Do not tell the others I have found something. I have found somewhere to look."],"production_nb":"Gradvis fordypning etter et menneskelig, ordin\u00e6rt kontor. Dale har jobbet med spor og kjenner st\u00e5stedet, men vet ikke \u00e5rsak, C, Nora eller finalen. Ingen talt opplesning med Kinski-profil; dokumenttekst er skriftlig."},{"id":"EV_DALE_SKYLOG","title":"Lights above the ridge / 6 April","kind":"hand","stamp":"6 APR 1986 / personal observation","body":["6 APR. Kitchen clock about 20:40. One white light crossed above the ridge and stopped where there is no tower. I went outside. It moved again before I found the binoculars. Aircraft remain possible; I lost the horizon behind the roof. What bothers me is the dog. He kept watching the empty place for another ten minutes."],"production_nb":"Fiktiv frivillig tekst i faktisk kontormappe. Ingen bilde- eller lydfil eller m\u00e5lt hendelsesbevis tildeles fra teksten."},{"id":"EV_DALE_WITNESS","title":"Statement copied at the service desk / 29 March","kind":"typed","stamp":"29 MAR 1986 / copied by D.","body":["Mrs. Bell says she heard someone crossing the yard after the porch lamp failed. The shape stood beside the washing line, taller than her husband. She called his name. It bent toward the window without taking a step. Her husband was asleep upstairs. She asked me to write \u201cperson,\u201d not \u201ccreature.\u201d I have kept her wording. I did not see it."],"production_nb":"Fiktiv frivillig tekst i faktisk kontormappe. Ingen bilde- eller lydfil eller m\u00e5lt hendelsesbevis tildeles fra teksten."},{"id":"EV_DALE_EXPLANATIONS","title":"Explanations retained / working sheet","kind":"hand","stamp":"WORKING SHEET / D.","body":["Three reports were aircraft. One bright object was visible from the same chair on four clear evenings: a star, made strange by the window glass. Keep those pages. Crossing out an explanation does not make the next report true. The service-road account remains open because neither witness describes the same direction. Ask separately before showing either one the other statement."],"production_nb":"Fiktiv frivillig tekst i faktisk kontormappe. Ingen bilde- eller lydfil eller m\u00e5lt hendelsesbevis tildeles fra teksten."},{"id":"EV_DALE_FRAME18","title":"Photograph envelope / frame 18","kind":"hand","stamp":"FRAME 18 / envelope text only","body":["Envelope annotation. No photograph or negative is enclosed in this working copy.","Do not crop the left edge. The porch post is the only useful measure of height. The pale mark might be glare from the kitchen window; t)S47EV")
TEXT(R"S47EV(he negative needs checking. What I remember is a shape standing beyond the fence. What the photograph contains may be something else. Keep both sentences. I am starting to replace one with the other."],"production_nb":"Fiktiv frivillig tekst i faktisk kontormappe. Ingen bilde- eller lydfil eller m\u00e5lt hendelsesbevis tildeles fra teksten."},{"id":"EV_DALE_TAPELOAN","title":"Borrowed cassette / return sleeve","kind":"hand","stamp":"RETURN TUESDAY / borrowed cassette","body":["Public lecture, borrowed from a neighbor. Speakers describe visitors, contact and messages from elsewhere. No local recording. No connection established with the service-road tape. I kept it because people use these words when they call, and I need to know what they have heard already. Return it on Tuesday. Do not record over the label. There are family birthdays underneath."],"production_nb":"Fiktiv frivillig tekst i faktisk kontormappe. Ingen bilde- eller lydfil eller m\u00e5lt hendelsesbevis tildeles fra teksten."},{"id":"EV_DALE_UNSENT","title":"Unsent letter / no address","kind":"hand","stamp":"UNSENT / no address","body":["I was going to tell you about the lights, then I read this back and heard how it sounded. You would ask whether I am sleeping. Fair question. I still do the shopping. I still forget the milk. I would like one evening when the telephone rings and I expect an ordinary problem. Do not mail this. Get some sleep first."],"production_nb":"Fiktiv frivillig tekst i faktisk kontormappe. Ingen bilde- eller lydfil eller m\u00e5lt hendelsesbevis tildeles fra teksten."},{"id":"EV_DALE_ARRAY_SERVICE","title":"Array service / Row One sighting positions","kind":"typed","stamp":"SARO / ARRAY SERVICE / APR 1986","body":["FOOT ACCESS. Use the walk gate north of the control room. The cable trench is the north-south spine. Follow its gravel track to the first east-west service row; do not cross a pedestal or climb a reflector.","The small service boards mark A / ROW ONE WEST, seven metres west of the trench, and B / ROW ONE EAST, nineteen metres east of the trench. Both stand on the same continuous gravel row. The fixed REF / R1 board is at the trench junction. S-02 is south of the western side; S-03 is south of the eastern side; S-04 is north of the row.","For an ordinary sighting comparison, keep the reference board in place and note the reflector position against the same fixed features from A and B. Either standing position may be visited first. Return along the same row and spine to the walk gate. Check command history and the local drive state separately before attributing a movement to a source.","This is a service layout, not a recorded result or an instruction to energise a drive. A recording can establish sound and elapsed time; it cannot establish bearing. The Caliche culvert camera position remains on the separate FIELD CHECKS working index."],"production_nb":"Ordin\u00e6rt feltvedlegg; A=(-8,-74), B=(18,-74), REF=(-1,-74) i eksisterende three-koordinater. Punktene er p\u00e5 fRow1, unng\u00e5r fundament/collider, og n\u00e5s fra gate/fSpine. Ingen ARRAY-01-fullf\u00f8ring gis; ny kontroll-/retrettlogikk er separat."}],"media":[{"id":"VHS_DALE_FIELD_01","title":"Service Road / Field 01","duration_seconds":72,"production_nb":"Produksjonsmanus for ny faktisk 72 sekunders bevegelig VHS-film med milj\u00f8lyd. Ingen fil er generert. Ingen talt Dale, fysisk Dale, spillerstemme eller Kinski-forteller; Dale finnes bare som h\u00e5ndskrevne kort. Kameraets feil dato brennes ikke inn som p\u00e5litelig tid. Filmstedet modelleres sammen med T02, og samme st\u00e5sted m\u00e5 kunne finnes i gameplay. Avviket er bevegelig og uklart, men adskilles fra kamera-/trackingbevegelse med stabile referanser. Ikke gjenbruk film som et statisk bevisfoto. Uavklart \u00e5rsak; ingen synlig full alien eller forklaring av C/finalen. F\u00f8rste avspilling kan pauseres/avbrytes og spilles igjen; bare hele avspilling gir vhs_seen. Tekstkort er engelske og lesbare ogs\u00e5 med undertekster.","beats":[{"at":0,"until":7,"picture_nb":"Bevegelig opptak starter nede ved veikanten; kameraet l\u00f8ftes fra grusen forbi lav kulvert og gjerdet. Et kort skriftlig p\u00e5legg i h\u00e5ndskrift er synlig over den levende filmen. Ingen person eller h\u00e5nd m\u00e5 identifiseres som Dale.","audio_nb":"B\u00e5ndstart, svak motor i det fjerne, vind mot mikrofonen og kontinuerlig elektrisk romling. Ingen tale.","subtitle":"SERVICE ROAD / FIELD 01\nCamera date incorrect. Use position, not timestamp."},{"at":7,"until":17,"picture_nb":"Rolig panorering viser serviceporten og stolpen med n\u00f8yaktig to hvite b\u00e5nd. Kameraet finner inspeksjonsst\u00e5stedet og rammer inn n\u00e6rmeste stolpe, to ledere og gjerdehj\u00f8rnet nederst til venstre. En avgrenset inspeksjonslampe lyser.","audio_nb":"Vind, sm\u00e5 metalliske klirr i gjerdet, jevn svak romling. Lydperspektivet f\u00f8lger panoramaet. Ingen spenningsdramaturgi eller musikk.","subtitle":"Road side of the two-band post.\nCulvert beside the service gate."},{"at":17,"until":27,"picture_nb":"Kameraet holdes i samme utsnitt med liten naturlig h\u00e5ndholdt drift. Stolpen og begge lederne er hele i bildet. En liten st\u00f8vstripe g\u00e5r langs bakken i \u00e9n retning. P\u00e5legget kommer fra et skriftlig notat, uten opplesning.","audio_nb":"Vind i samme retning og et lavt, uregelmessig gjerdetikk. Lampen gir ingen egen overdreven effektlyd.","subtitle":"Nearest pole and both outer wires in frame.\nThe lamp alone proves nothing about its supply."},{"at":27,"until":39,"picture_nb":"En smal gr\u00e5lig forskyvning oppst\u00e5r ved den \u00f8verste lederen. Den glir sakte sideveis mot st\u00f8vets retning, krysser det tomme mellomrommet under lederen og stanser et \u00f8yeblikk ved stolpen. N\u00e6rmeste stolpe, gjerde og ledere forblir stabile. Det kan ligne en m\u00f8rk fold i luften eller en lokal feil i b\u00e5ndet, uten gjenkjennelig kropp. Ingen skjermomfattende glitch skjuler bev)S47EV")
TEXT(R"S47EV(egelsen.","audio_nb":"Samme milj\u00f8lyd fortsetter. En kort lav demping av rumlingen, h\u00f8rbar men ikke et h\u00f8yt st\u00f8t. Ingen stemme eller pust fra et vesen.","subtitle":""},{"at":39,"until":49,"picture_nb":"Kameraet tar et lite skritt sidelengs. Den gr\u00e5 forskyvningen glir bak stolpens silhuett og et lite stykke ned, mens gjerdehj\u00f8rnet endrer plass ved normal parallakse. Den forsvinner gradvis f\u00f8r bevegelsen i kameraet stopper. Hold tydelig lesbar bevegelse og dekning; ingen teleportert modell eller statisk p\u00e5limt klatt.","audio_nb":"Ett vanlig grusskritt, kl\u00e6r mot mikrofonen, vind og gjerdet. Romlingen g\u00e5r tilbake til tidligere niv\u00e5 uten dramatisk stinger.","subtitle":""},{"at":49,"until":61,"picture_nb":"Kameraet g\u00e5r tilbake til merket ved kulverten og holder det opprinnelige utsnittet. Ledningene beveger seg svakt normalt i vinden. Lampen lyser fremdeles. Ingen ny form kommer; b\u00e5ndet fortsetter som en faktisk sammenhengende registrering.","audio_nb":"Grus, vind og vanlig elektrisk romling. En fugl langt unna. Ingen tale.","subtitle":"Did the patch move with the camera?\nCompare the pole, not the tracking line."},{"at":61,"until":72,"picture_nb":"Sakte tilt ned mot kulverten og de to hvite b\u00e5ndene som gj\u00f8r plassen gjenfinnbar. Bildet holder seg levende med st\u00f8v og svak kameradrift under siste h\u00e5ndskrevne p\u00e5legg. Film slutter ved72, ingen ytterligere skjult hendelse.","audio_nb":"Vind og fjernt motorbrum; vanlig b\u00e5ndstopp ved slutten. Ingen Dale-opplesning.","subtitle":"Return to this position.\nCheck the ordinary supply first. Then make a fresh observation.\n\u2014 D."}]}],"strings":[{"id":"OFFICE_KEY_ITEM","text":"Operations spare key","context_nb":"Eget n\u00f8kkelnavn; aldri Noras n\u00f8kkel."},{"id":"OFFICE_DOOR_LOCKED","text":"Operations office \u2014 locked","context_nb":"D\u00f8rens fokusbeskrivelse f\u00f8r reserven\u00f8kkel."},{"id":"OFFICE_DOOR_UNLOCK","text":"Use the Operations spare","context_nb":"Handlingen p\u00e5 eksisterende l\u00e5ste kontord\u00f8r."},{"id":"OFFICE_SERVICE_DRAWER","text":"Service drawer","context_nb":"Gjenfinnbar fysisk skuff ved arbeidsbenken."},{"id":"OFFICE_FIELD_FOLDER","text":"Field checks","context_nb":"Den ordin\u00e6re mappen under arbeidsbilagene."},{"id":"OFFICE_READ_INDEX","text":"Read the working index","context_nb":"\u00c5pner EV_DALE_INDEX."},{"id":"OFFICE_READ_CLIPPINGS","text":"Examine the local cuttings","context_nb":"Valgfri fordypning."},{"id":"OFFICE_READ_NOTE","text":"Read the folded note","context_nb":"\u00c5pner EV_DALE_NOTE."},{"id":"OFFICE_KEEP_CONTACT","text":"Copy the field contact","context_nb":"Kopier kontaktkort uten automatisk samtale."},{"id":"OFFICE_TAKE_COPY","text":"Take the field sheet","context_nb":"Kort hovedrute med konkret spor; \u00f8vrig research valgfritt."},{"id":"OFFICE_PLAY_TAPE","text":"Play Service Road / Field 01","context_nb":"Faktisk film og milj\u00f8lyd, ingen forteller."},{"id":"OFFICE_REPLAY_TAPE","text":"Replay the field tape","context_nb":"Kan gjentas uten \u00e5 duplisere funn."},{"id":"OFFICE_TAPE_NO_POWER","text":"The VHS deck has no power. The field sheet is beside it.","context_nb":"Vis bare ved faktisk str\u00f8mmangel; n\u00f8dvendig feltspor ligger p\u00e5 papiret."},{"id":"OFFICE_TAPE_UNAVAILABLE","text":"The tape will not play. The field sheet still gives the camera position.","context_nb":"Feilvisning hvis filmfil mangler/feiler; ikke simuler film med stillbilde eller gi vhs_seen."},{"id":"OFFICE_FIELD_LEAD","text":"Service road: compare the view from the culvert beside the two-band post.","context_nb":"Konkret feltspor til T02, separat fra STATION 01 og P13."},{"id":"OFFICE_INVESTIGATION_NOTE","text":"The recording gives a position to check. It does not identify what moved.","context_nb":"Saksnotat ved avsluttet tape, uten automatisk forklaring."},{"id":"OFFICE_CONTACT_ACTION","text":"Contact Dale on the service line","context_nb":"Kontaktknapp overlates til egnet telefon-/walkiemodul; ingen fysisk Dale."},{"id":"OFFICE_RETURN_TASK","text":"Keep the survey papers separate. Continue the archive check.","context_nb":"Retur til gjeldende hovedarkivreise; ingen automatisk ny fase."}]},{"module_id":"field","flags":{"field_reflection_checked":{"default":false,"purpose_nb":"Den vanlige refleksen er kontrollert."},"field_service_read":{"default":false,"purpose_nb":"Det fysiske servicekortet er lest."},"field_reference_matched":{"default":false,"purpose_nb":"Spilleren har matchet det bevarte st\u00e5stedet i T02."},"field_followup_unresolved":{"default":false,"purpose_nb":"T02 er forel\u00f8pig uavklart; kan gjen\u00e5pnes."},"field_cutout_compared":{"default":false,"purpose_nb":"Spilleren har aktivt sammenlignet pappfiguren."},"field_studio_after_heard":{"default":false,"purpose_nb":"Det korte lydetterspillet er faktisk h\u00f8rt."}},"scenes":[{"id":"N01_ROUTINE","phase":"early_shift","channel":"ui","mode":"live","entry":"trigger","trigger_nb":"F\u00f8rste rutinekontroll i mappen p\u00e5 SARO etter telefonoverlevering.","requires":{"all":["handover_done"],"none":["routine_checked"]},"direction_nb":"Vis som kort unders\u00f8kelsestekst uten fortellerstemme. G\u00e5 tilbake til samme fysiske oppgave etterp\u00e5.","lines":[{"id":"N01_ROUTINE_001","speaker":"DESCRIPTION","text":"The service copy records an open inspection complaint. The radio sheet is a programme schedule, not a recording of the broadcast.","delivery_nb":"Ingen innspilt stemme. Tekst p\u00e5 panelet eller i notatboken."},{"id":"N01_ROUTINE_002","speaker":"DESCRIPTION","text":"Both copies are dated. Neither tells you what will happen later tonight.","delivery_nb":"Ingen innspilt stemme. Tekst p\u00e5 panelet eller i notatboken."}],"choices":[],"on_complete":{"set_flags":{"routine_checked":true},"give_documents":["EV_SERVICE_LOG","EV_RADIO_SCHEDULE"]}},{"id":"N01_COMPARE","phase":"signal","channel":"ui","mode":"live","entry":"trigger","trigg)S47EV")
TEXT(R"S47EV(er_nb":"Spilleren legger egne dokumenter ved siden av den faktiske utskriften. Ikke automatisk ved \u00e5 n\u00e6rme seg bordet.","requires":{"all":["routine_checked","ctx_signal_present"],"none":["record_compared"]},"direction_nb":"Vis som kort unders\u00f8kelsestekst uten fortellerstemme. G\u00e5 tilbake til samme fysiske oppgave etterp\u00e5.","lines":[{"id":"N01_COMPARE_001","speaker":"DESCRIPTION","text":"The residual is on the new printout. The service copy predates it.","delivery_nb":"Ingen innspilt stemme. Tekst p\u00e5 panelet eller i notatboken."},{"id":"N01_COMPARE_002","speaker":"DESCRIPTION","text":"The old complaint and this printout belong on the same timeline. That does not make them the same event.","delivery_nb":"Ingen innspilt stemme. Tekst p\u00e5 panelet eller i notatboken."}],"choices":[{"id":"N01_CH_COMPARE_EARLIER","label":"The earlier complaint does not establish the cause of this printout.","next":"N01_COMPARE_CAUTION","requires":{"all":[],"none":[]},"on_select":{"set_flags":{},"give_documents":[]}},{"id":"N01_CH_COMPARE_CAUSE","label":"The earlier complaint proves the supply caused the residual.","next":"N01_COMPARE_WRONG","requires":{"all":[],"none":[]},"on_select":{"set_flags":{},"give_documents":[]}},{"id":"N01_CH_COMPARE_UNCERTAIN","label":"There is not enough evidence to connect them.","next":"N01_COMPARE_CAUTION","requires":{"all":[],"none":[]},"on_select":{"set_flags":{},"give_documents":[]}}],"on_complete":{"set_flags":{},"give_documents":[]}},{"id":"N01_COMPARE_WRONG","phase":"signal","channel":"ui","mode":"live","entry":"choice","trigger_nb":"Konkret tilbakemelding uten straff. Behold dokumenter og tillat ny vurdering.","requires":{"all":[],"none":[]},"direction_nb":"Vis som kort unders\u00f8kelsestekst uten fortellerstemme. G\u00e5 tilbake til samme fysiske oppgave etterp\u00e5.","lines":[{"id":"N01_COMPARE_WRONG_001","speaker":"DESCRIPTION","text":"The copy records a complaint and an inspection request. It does not record the supply at the moment of the residual.","delivery_nb":"Ingen innspilt stemme. Tekst p\u00e5 panelet eller i notatboken."},{"id":"N01_COMPARE_WRONG_002","speaker":"DESCRIPTION","text":"Use the actual inspection result and the later observation. The dates alone cannot settle the cause.","delivery_nb":"Ingen innspilt stemme. Tekst p\u00e5 panelet eller i notatboken."}],"choices":[{"id":"N01_CH_REVISE","label":"Record the comparison as unresolved.","next":"N01_COMPARE_CAUTION","requires":{"all":[],"none":[]},"on_select":{"set_flags":{},"give_documents":[]}}],"on_complete":{"set_flags":{},"give_documents":[]}},{"id":"N01_COMPARE_CAUTION","phase":"signal","channel":"ui","mode":"live","entry":"choice","trigger_nb":"Gyldig avslutning av N01, ogs\u00e5 ved uavklart resultat.","requires":{"all":[],"none":[]},"direction_nb":"Vis som kort unders\u00f8kelsestekst uten fortellerstemme. G\u00e5 tilbake til samme fysiske oppgave etterp\u00e5.","lines":[{"id":"N01_COMPARE_CAUTION_001","speaker":"DESCRIPTION","text":"Comparison filed: earlier service complaint; later residual. A shared cause is not established.","delivery_nb":"Ingen innspilt stemme. Tekst p\u00e5 panelet eller i notatboken."},{"id":"N01_COMPARE_CAUTION_002","speaker":"DESCRIPTION","text":"Keep the actual inspection result with the printout.","delivery_nb":"Ingen innspilt stemme. Tekst p\u00e5 panelet eller i notatboken."}],"choices":[],"on_complete":{"set_flags":{"record_compared":true},"give_documents":[]}},{"id":"N02_REFLECTION","phase":"early_shift","channel":"ui","mode":"live","entry":"trigger","trigger_nb":"Kun etter at spilleren faktisk har flyttet st\u00e5sted og tatt den vanlige kontrollen.","requires":{"all":["ctx_room_quiet"],"none":["field_reflection_checked"]},"direction_nb":"En forklarlig kontroll, ikke en skjult skikkelse. Tilby st\u00e5stedshjelp fremfor \u00e5 kreve perfekt sikting.","lines":[{"id":"N02_REFLECTION_001","speaker":"DESCRIPTION","text":"From the first position, the bright edge resembles a person behind the glass.","delivery_nb":"Ingen innspilt stemme. Tekst p\u00e5 panelet eller i notatboken."},{"id":"N02_REFLECTION_002","speaker":"DESCRIPTION","text":"From the side, it follows the room lamp. The photograph shows the same reflection.","delivery_nb":"Ingen innspilt stemme. Tekst p\u00e5 panelet eller i notatboken."}],"choices":[],"on_complete":{"set_flags":{"field_reflection_checked":true},"give_documents":[]}},{"id":"T01_SERVICE_LOG","phase":"early_shift","channel":"ui","mode":"live","entry":"trigger","trigger_nb":"Les fysisk servicekort ved trafostasjonens betjeningsfront.","requires":{"all":["handover_done"],"none":["field_service_read"]},"direction_nb":"Vis som kort unders\u00f8kelsestekst uten fortellerstemme. G\u00e5 tilbake til samme fysiske oppgave etterp\u00e5.","lines":[{"id":"T01_SERVICE_LOG_001","speaker":"DESCRIPTION","text":"Inspection circuit. The open complaint describes a weak exterior lamp, not a failure of the observatory receiver.","delivery_nb":"Ingen innspilt stemme. Tekst p\u00e5 panelet eller i notatboken."},{"id":"T01_SERVICE_LOG_002","speaker":"DESCRIPTION","text":"The label on the service card matches the marked inspection front.","delivery_nb":"Ingen innspilt stemme. Tekst p\u00e5 panelet eller i notatboken."}],"choices":[],"on_complete":{"set_flags":{"field_service_read":true},"give_documents":["EV_TRAFO_CARD"]}},{"id":"T01_REQUEST_CHECK","phase":"early_shift","channel":"ui","mode":"live","entry":"trigger","trigger_nb":"Velg den fiktive servicekontrollen etter \u00e5 ha lest kortet.","requires":{"all":["field_service_read"],"none":["trafo_normal_checked"]},"direction_nb":"Start en avgrenset verdenstest via adapteren. Scenen setter ikke suksess. Den lokale modellen m\u00e5 faktisk gi forventet kontrollrespons. Ingen inngrep i eksponerte h\u00f8yspentdeler.","lines":[{"id":"T01_REQUEST_CHECK_001","speaker":"DESCRIPTION","text":"The service check compares the panel result with the actual inspection light.","delivery_nb":"Inge)S47EV")
