TEXT(R"S47EV(},"scenes":[{"id":"I01_DRIVE","phase":"commute","channel":"radio","mode":"live","entry":"trigger","trigger_nb":"\u00c5pning p\u00e5 innkj\u00f8ringen til Caliche, f\u00f8r SARO-skiftet. Avspilling stopper ved utstigning og kan fortsette i bilen.","requires":{"all":[],"none":["arrival_radio_heard","intro_arrived"]},"direction_nb":"Sen ettermiddag 13. april. Kj\u00f8rbar innledning, ingen nedtelling. Egen vanlig radiovert, ikke Earl eller Dale. Lystig original eller klarert instrumental g\u00e5r f\u00f8r og mellom replikkene. \u00c5pne hus, noen folk og vanlig trafikk gj\u00f8r byen lesbar.","lines":[{"id":"I01_DRIVE_001","speaker":"RADIO_HOST","text":"Good afternoon, Caliche. Hope your Sunday has been an easy one.","delivery_nb":"Lett og munter lokalradio."},{"id":"I01_DRIVE_002","speaker":"RADIO_HOST","text":"We've still got a little sunshine left. Good time to get the washing off the line.","delivery_nb":"Sm\u00e5prat, uten ladet pause."},{"id":"I01_DRIVE_003","speaker":"RADIO_HOST","text":"A reminder from the feed store: tomorrow's delivery comes in after ten. Let them have their coffee first.","delivery_nb":"Smil i stemmen."},{"id":"I01_DRIVE_004","speaker":"RADIO_HOST","text":"And if you're heading out to work, the diner has the griddle on.","delivery_nb":"Som en vanlig lokal opplysning."},{"id":"I01_DRIVE_005","speaker":"RADIO_HOST","text":"Take it easy through town. There's no prize for getting to the next red light first.","delivery_nb":"Lunt."},{"id":"I01_DRIVE_006","speaker":"RADIO_HOST","text":"Here's another record for the road.","delivery_nb":"Kort, gi plass til musikken."}],"choices":[],"on_complete":{"set_flags":{"arrival_radio_heard":true},"give_documents":[]}},{"id":"I02_DINER_HELLO","phase":"commute","channel":"physical","mode":"live","entry":"trigger","trigger_nb":"F\u00f8rste aktive henvendelse ved dinerdisken f\u00f8r intro_arrived. Stoppet er valgfritt.","requires":{"all":[],"none":["arrival_diner_finished","food_bought","intro_arrived"]},"direction_nb":"Servitrisen t\u00f8rker disken og legger frem meny. Vanlig lys, kj\u00f8kkenlyd og uanstrengt stemning. Ingen skjult horrorreplikk. Spilleren er taus.","lines":[{"id":"I02_DINER_HELLO_001","speaker":"WAITRESS","text":"Hi there. Sit wherever you like.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I02_DINER_HELLO_002","speaker":"WAITRESS","text":"Kitchen's still going. Coffee's fresh enough that I can say it with a straight face.","delivery_nb":"Lett humor."},{"id":"I02_DINER_HELLO_003","speaker":"WAITRESS","text":"You want to see the menu, or are you just stretching your legs?","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."}],"choices":[{"id":"I02_MENU","label":"Let me see the menu.","next":"I03_MENU","requires":{"all":[],"none":["food_bought"]},"on_select":{"set_flags":{},"give_documents":[]}},{"id":"I02_WATER","label":"Just a glass of water, please.","next":"I08_WATER","requires":{"all":[],"none":[]},"on_select":{"set_flags":{},"give_documents":[]}},{"id":"I02_ROAD","label":"How is the road out to SARO?","next":"I14_ROAD","requires":{"all":[],"none":[]},"on_select":{"set_flags":{},"give_documents":[]}},{"id":"I02_LEAVE","label":"I should keep moving.","next":"I09_LEAVE","requires":{"all":[],"none":[]},"on_select":{"set_flags":{},"give_documents":[]}}],"on_complete":{"set_flags":{},"give_documents":[]}},{"id":"I03_MENU","phase":"commute","channel":"physical","mode":"live","entry":"choice","trigger_nb":"\u00c5pnes fra velkomst eller kort sm\u00e5prat. Menyvalg er kj\u00f8ps\u00f8yeblikket og utf\u00f8res \u00e9n gang.","requires":{"all":[],"none":["food_bought","intro_arrived"]},"direction_nb":"En enkel papirmeny med to synlige matvalg. Integrasjon m\u00e5 fullf\u00f8re valgt svarnode ogs\u00e5 hvis samtalen avbrytes etter kj\u00f8p; samme bestilling skal ikke belastes eller gis to ganger.","lines":[{"id":"I03_MENU_001","speaker":"WAITRESS","text":"Burger comes with fries. Sandwich comes with chips.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I03_MENU_002","speaker":"WAITRESS","text":"Coffee with either one. I can wrap the food if you're taking it to work.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I03_MENU_003","speaker":"WAITRESS","text":"What sounds good?","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."}],"choices":[{"id":"I03_BURGER","label":"Buy a burger, fries and coffee.","next":"I04_BURGER","requires":{"all":[],"none":["food_bought"]},"on_select":{"set_flags":{"food_bought":true,"arrival_order_burger":true},"give_documents":[]}},{"id":"I03_SANDWICH","label":"Buy a sandwich, chips and coffee.","next":"I05_SANDWICH","requires":{"all":[],"none":["food_bought"]},"on_select":{"set_flags":{"food_bought":true,"arrival_order_sandwich":true},"give_documents":[]}},{"id":"I03_COOK","label":"What would you have?","next":"I15_RECOMMEND","requires":{"all":[],"none":[]},"on_select":{"set_flags":{},"give_documents":[]}},{"id":"I03_DECLINE","label":"Nothing today, thanks.","next":"I09_LEAVE","requires":{"all":[],"none":[]},"on_select":{"set_flags":{},"give_documents":[]}}],"on_complete":{"set_flags":{},"give_documents":[]}},{"id":"I04_BURGER","phase":"commute","channel":"physical","mode":"live","entry":"choice","trigger_nb":"Svar p\u00e5 burgerkj\u00f8pet. Kj\u00f8psflagget er allerede satt.","requires":{"all":["food_bought","arrival_order_burger"],"none":["arrival_diner_finished"]},"direction_nb":"Vis burger, pommes frites og kaffekopp p\u00e5 et brett foran spilleren. Gjenstanden og reaksjonen m\u00e5 v\u00e6re synlig; et skjult flagg alene oppfyller ikke handlingen.","lines":[{"id":"I04_BURGER_001","speaker":"WAITRESS","text":"One burger, fries and coffee. Coming right up.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I04_BURGER_002","speaker":"WAITRESS","text":"There you go. Careful with the plate.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I04_BURGER_003",)S47EV")
TEXT(R"S47EV("speaker":"WAITRESS","text":"Eating here, or shall I wrap it?","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."}],"choices":[{"id":"I04_EAT","label":"Eat here.","next":"I06_EAT","requires":{"all":[],"none":[]},"on_select":{"set_flags":{},"give_documents":[]}},{"id":"I04_TAKE","label":"Take it with me.","next":"I07_TAKE","requires":{"all":[],"none":[]},"on_select":{"set_flags":{},"give_documents":[]}}],"on_complete":{"set_flags":{},"give_documents":[]}},{"id":"I05_SANDWICH","phase":"commute","channel":"physical","mode":"live","entry":"choice","trigger_nb":"Svar p\u00e5 sandwichkj\u00f8pet. Kj\u00f8psflagget er allerede satt.","requires":{"all":["food_bought","arrival_order_sandwich"],"none":["arrival_diner_finished"]},"direction_nb":"Vis sandwich, chips og kaffekopp p\u00e5 et brett foran spilleren. Ingen andre ordre skal opprettes ved gjen\u00e5pning.","lines":[{"id":"I05_SANDWICH_001","speaker":"WAITRESS","text":"Sandwich, chips and coffee. You got it.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I05_SANDWICH_002","speaker":"WAITRESS","text":"Here we are. Napkins are right beside you.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I05_SANDWICH_003","speaker":"WAITRESS","text":"Staying for a minute, or taking that along?","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."}],"choices":[{"id":"I05_EAT","label":"Eat here.","next":"I06_EAT","requires":{"all":[],"none":[]},"on_select":{"set_flags":{},"give_documents":[]}},{"id":"I05_TAKE","label":"Take it with me.","next":"I07_TAKE","requires":{"all":[],"none":[]},"on_select":{"set_flags":{},"give_documents":[]}}],"on_complete":{"set_flags":{},"give_documents":[]}},{"id":"I06_EAT","phase":"commute","channel":"physical","mode":"live","entry":"choice","trigger_nb":"Spilleren velger \u00e5 spise. Kort rolig bordsekvens, deretter fri kontroll og retur til bilen.","requires":{"all":["food_bought"],"none":["arrival_diner_finished","food_taken"]},"direction_nb":"Vis at mat faktisk spises: tallerken/brett endres fra fullt til spist, kaffe reduseres, servitrisen samler inn. Ingen sultsystem eller klokkestraff. Rester skal ikke samtidig gis som ny takeaway.","lines":[{"id":"I06_EAT_001","speaker":"WAITRESS","text":"Sure. Take your time.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I06_EAT_002","speaker":"WAITRESS","text":"Mind if I top that coffee up?","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I06_EAT_003","speaker":"WAITRESS","text":"There. That should keep you going.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I06_EAT_004","speaker":"WAITRESS","text":"Thanks for stopping in. Have a good shift.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."}],"choices":[],"on_complete":{"set_flags":{"food_eaten":true,"arrival_diner_finished":true},"give_documents":[]}},{"id":"I07_TAKE","phase":"commute","channel":"physical","mode":"live","entry":"choice","trigger_nb":"Spilleren velger \u00e5 ta med. Etter utlevering g\u00e5r kontrollen tilbake til disken, s\u00e5 bilen.","requires":{"all":["food_bought"],"none":["arrival_diner_finished","food_eaten"]},"direction_nb":"Vis at samme kj\u00f8pte mat pakkes i papirpose og kaffe f\u00e5r lokk. Gi \u00e9n synlig pose i inventar/transportplass og \u00e9n reaksjonstekst. Ved ankomst kan posen settes p\u00e5 SAROs personalbord; et senere spisevalg m\u00e5 bruke samme porsjon.","lines":[{"id":"I07_TAKE_001","speaker":"WAITRESS","text":"No trouble. I'll put it in a bag.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I07_TAKE_002","speaker":"WAITRESS","text":"Fork and napkins are in there. Coffee's got a lid.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I07_TAKE_003","speaker":"WAITRESS","text":"Keep the bag upright. The bottom's got more confidence than strength.","delivery_nb":"Smilende, vanlig sp\u00f8k."},{"id":"I07_TAKE_004","speaker":"WAITRESS","text":"Have a good evening out there.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."}],"choices":[],"on_complete":{"set_flags":{"food_taken":true,"arrival_diner_finished":true},"give_documents":[]}},{"id":"I08_WATER","phase":"commute","channel":"physical","mode":"live","entry":"choice","trigger_nb":"Gratis vann etter velkomst. Valget avslutter ikke automatisk bes\u00f8ket.","requires":{"all":[],"none":["food_bought","arrival_diner_finished","intro_arrived"]},"direction_nb":"Et glass vann settes synlig p\u00e5 disken; ingen mat eller kj\u00f8psflagg. Ingen skjult betaling.","lines":[{"id":"I08_WATER_001","speaker":"WAITRESS","text":"Of course. Here you are.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I08_WATER_002","speaker":"WAITRESS","text":"You've caught us between the supper crowd and the coffee crowd.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I08_WATER_003","speaker":"WAITRESS","text":"Nice having a minute to wipe a table before somebody needs it.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I08_WATER_004","speaker":"WAITRESS","text":"Let me know if you change your mind about food.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."}],"choices":[{"id":"I08_MENU","label":"Actually, I will look at the menu.","next":"I03_MENU","requires":{"all":[],"none":["food_bought"]},"on_select":{"set_flags":{},"give_documents":[]}},{"id":"I08_ROAD","label":"Which turn takes me to SARO?","next":"I14_ROAD","requires":{"all":[],"none":[]},"on_select":{"set_flags":{},"give_documents":[]}},{"id":"I08_LEAVE","label":"Thanks. I should get going.","next":"I09_LEAVE","requires":{"all":[],"none":[]},"on_select":{"set_flags":{},"give_documents":[]}}],"on_complete":{"set_flags":{},"give_documents":[]}},{"id":"I09_LEAVE","phase":"commute","channel":"physical","mode":"live","entry":"choice","trigger_nb":"Spilleren avsl\u00e5r mat eller avslutter sm\u00e5prat. Fri kontro)S47EV")
TEXT(R"S47EV(ll ved utgang, deretter kj\u00f8ring.","requires":{"all":[],"none":["food_bought","arrival_diner_finished"]},"direction_nb":"Rydd meny/vann ved behov. Ingen kj\u00f8p, ingen sultstraff og ingen hindring for \u00e5 n\u00e5 SARO.","lines":[{"id":"I09_LEAVE_001","speaker":"WAITRESS","text":"All right. Thanks for coming in.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I09_LEAVE_002","speaker":"WAITRESS","text":"We're here if you need something later.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I09_LEAVE_003","speaker":"WAITRESS","text":"Drive safely.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."}],"choices":[],"on_complete":{"set_flags":{"arrival_diner_finished":true},"give_documents":[]}},{"id":"I10_BACK_ON_ROAD","phase":"commute","channel":"radio","mode":"live","entry":"trigger","trigger_nb":"Spilleren forlater Caliche mot SARO, enten direkte eller etter diner. Radiosekvensen krever ikke matkj\u00f8p.","requires":{"all":[],"none":["arrival_departure_radio_heard","intro_arrived"]},"direction_nb":"Gatens lyder viker for dekkst\u00f8y og musikk. Ingen skurring, avbrutt n\u00f8danrop eller fremmed skikkelse i denne sekvensen.","lines":[{"id":"I10_BACK_ON_ROAD_001","speaker":"RADIO_HOST","text":"You're listening to local radio here in Caliche.","delivery_nb":"Avslappet."},{"id":"I10_BACK_ON_ROAD_002","speaker":"RADIO_HOST","text":"Church supper volunteers, your pans are clean and waiting in the kitchen. Please take yours home before somebody makes another casserole in it.","delivery_nb":"Hverdagslig opplesning."},{"id":"I10_BACK_ON_ROAD_003","speaker":"RADIO_HOST","text":"We'll leave you with some music now.","delivery_nb":"Lyst."},{"id":"I10_BACK_ON_ROAD_004","speaker":"RADIO_HOST","text":"Good evening to everybody starting work, and everybody heading home.","delivery_nb":"Vanlig avslutning."}],"choices":[],"on_complete":{"set_flags":{"arrival_departure_radio_heard":true},"give_documents":[]}},{"id":"I11_SARO_ARRIVAL","phase":"handover","channel":"ui","mode":"live","entry":"trigger","trigger_nb":"N\u00e5r bilen er parkert ved SARO og spilleren g\u00e5r inn p\u00e5 skiftet. Kan n\u00e5s selv om dineren aldri ble bes\u00f8kt.","requires":{"all":[],"none":["intro_arrived"]},"direction_nb":"Vis datolinje og skiftstart 18:00. Innkj\u00f8ringen har ingen nedtelling; klokken begynner p\u00e5 skiftets tidspunkt ved dette punktet. Behold kj\u00f8pt mat. Dales overlevering eies av egen modul og kommer bare over telefon eller radio. Ingen fysisk kollega venter.","lines":[],"choices":[],"on_complete":{"set_flags":{"intro_arrived":true},"give_documents":[]}},{"id":"I12_ALL_NIGHT_BOUGHT","phase":"all_night","channel":"physical","mode":"live","entry":"trigger","trigger_nb":"Kort velkomst ved f\u00f8rste diskhenvendelse i eksisterende All Night, bare etter tidligere matkj\u00f8p.","requires":{"all":["ctx_all_night_active","food_bought"],"none":["arrival_late_greeted"]},"direction_nb":"Gi plass til kapittelets eksisterende dialog. Ingen ny bestilling, automatisk bevisutlevering eller l\u00f8sning av kart/P13. On_complete gir kontroll tilbake til eksisterende dinerflyt.","lines":[{"id":"I12_ALL_NIGHT_BOUGHT_001","speaker":"WAITRESS","text":"Hi again. Back from SARO?","delivery_nb":"Gjenkjennende, litt tr\u00f8tt."},{"id":"I12_ALL_NIGHT_BOUGHT_002","speaker":"WAITRESS","text":"Coffee's on. You can sit down a minute.","delivery_nb":"Rolig omsorg, ingen trussel."},{"id":"I12_ALL_NIGHT_BOUGHT_003","speaker":"WAITRESS","text":"That driver came in a little while ago. He's over there if you're looking for somebody who's been on the road.","delivery_nb":"Pek diskret mot eksisterende sj\u00e5f\u00f8r."},{"id":"I12_ALL_NIGHT_BOUGHT_004","speaker":"WAITRESS","text":"There's a paper on the counter, too. Nobody's claimed it.","delivery_nb":"Nevner den eksisterende avisen uten \u00e5 forklare dens funn."}],"choices":[],"on_complete":{"set_flags":{"arrival_late_greeted":true},"give_documents":[]}},{"id":"I13_ALL_NIGHT_NO_FOOD","phase":"all_night","channel":"physical","mode":"live","entry":"trigger","trigger_nb":"Alternativ velkomst ved f\u00f8rste diskhenvendelse i All Night hvis ingen mat ble kj\u00f8pt. Fungerer ogs\u00e5 n\u00e5r hele f\u00f8rste stopp ble hoppet over.","requires":{"all":["ctx_all_night_active"],"none":["food_bought","arrival_late_greeted"]},"direction_nb":"Ordlyden forutsetter ikke tidligere m\u00f8te. Samme retur til eksisterende dinerflyt som I12. Ikke sett food_bought; senere originaldialog kan h\u00e5ndtere \u00f8vrig servering.","lines":[{"id":"I13_ALL_NIGHT_NO_FOOD_001","speaker":"WAITRESS","text":"Evening. Coming in from work?","delivery_nb":"Varmt, tr\u00f8tt."},{"id":"I13_ALL_NIGHT_NO_FOOD_002","speaker":"WAITRESS","text":"Take a seat if you need one. Coffee's on.","delivery_nb":"Avslappet."},{"id":"I13_ALL_NIGHT_NO_FOOD_003","speaker":"WAITRESS","text":"That fellow over there just came off the road. He's been sitting with his cup for a while.","delivery_nb":"Vis eksisterende sj\u00e5f\u00f8r."},{"id":"I13_ALL_NIGHT_NO_FOOD_004","speaker":"WAITRESS","text":"Paper's on the counter if you want something to read.","delivery_nb":"Ingen trykk p\u00e5 avisen eller den relevante artikkelen."}],"choices":[],"on_complete":{"set_flags":{"arrival_late_greeted":true},"give_documents":[]}},{"id":"I14_ROAD","phase":"commute","channel":"physical","mode":"live","entry":"choice","trigger_nb":"Valgfritt vanlig sp\u00f8rsm\u00e5l om veien, fra velkomst eller vannglass.","requires":{"all":[],"none":["food_bought","arrival_diner_finished","intro_arrived"]},"direction_nb":"Samtalen orienterer mot SARO. Ingen profeti, advarsel om s\u00e6r oppf\u00f8rsel eller referanse til senere hendelser.","lines":[{"id":"I14_ROAD_001","speaker":"WAITRESS","text":"Keep on through town, then take the marked turn out to the array.","delivery_nb":"Hverdagslig og varm. Ingen antydning til fare."},{"id":"I14_ROAD_002","speaker":"WAITRESS","text":"Big sign. Hard to mi)S47EV")
