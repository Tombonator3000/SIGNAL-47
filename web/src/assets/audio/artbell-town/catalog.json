{
  "version": 1,
  "voice": "Art Bell synthetic parody for Earl in town",
  "clips": [
    {
      "id": "56e7a020339f079f",
      "text": "I've got a record on. Three minutes and forty seconds, so talk fast.",
      "duration": 3.97,
      "file": "56e7a020339f079f.mp3"
    },
    {
      "id": "0772acf7684b121e",
      "text": "You again. Song and a half this time.",
      "duration": 2.16,
      "file": "0772acf7684b121e.mp3"
    },
    {
      "id": "3dd0d7b88a382fe9",
      "text": "Lights, mostly. Cattle, some nights. Engines.",
      "duration": 2.8,
      "file": "3dd0d7b88a382fe9.mp3"
    },
    {
      "id": "073fce364994cf9e",
      "text": "And missing time. You read that book? Everybody's read that book now.",
      "duration": 4.02,
      "file": "073fce364994cf9e.mp3"
    },
    {
      "id": "3a345d802b2c405b",
      "text": "Half of them, I think they read it first and then it happened to them.",
      "duration": 3.86,
      "file": "3a345d802b2c405b.mp3"
    },
    {
      "id": "f60bda199fff5103",
      "text": "The other half never read anything in their lives.",
      "duration": 2.73,
      "file": "f60bda199fff5103.mp3"
    },
    {
      "id": "a3c152d2c160dfed",
      "text": "On the air I call them our visitors. It keeps it friendly.",
      "duration": 3.17,
      "file": "a3c152d2c160dfed.mp3"
    },
    {
      "id": "a75c7f370b3629f3",
      "text": "Off the air I don't call them anything.",
      "duration": 2.13,
      "file": "a75c7f370b3629f3.mp3"
    },
    {
      "id": "357153cc24cbf51d",
      "text": "Every one, on reel. Twelve years of them.",
      "duration": 2.38,
      "file": "357153cc24cbf51d.mp3"
    },
    {
      "id": "ef7a39269e528490",
      "text": "Except one. September of '81, a boy called in. I've never played it back.",
      "duration": 4.64,
      "file": "ef7a39269e528490.mp3"
    },
    {
      "id": "281daafd0a94d01a",
      "text": "I wasn't on the air that night. The station was off.",
      "duration": 2.76,
      "file": "281daafd0a94d01a.mp3"
    },
    {
      "id": "ecc59550da45471d",
      "text": "Record's ending.",
      "duration": 1.28,
      "file": "ecc59550da45471d.mp3"
    },
    {
      "id": "2965d89d13a00665",
      "text": "You heard him too.",
      "duration": 1.22,
      "file": "2965d89d13a00665.mp3"
    },
    {
      "id": "466b8eed89cf1d9e",
      "text": "I put the receiver down and tried the line again. Dial tone. Just a phone.",
      "duration": 4.28,
      "file": "466b8eed89cf1d9e.mp3"
    },
    {
      "id": "f58484cccf41a7b6",
      "text": "I haven't played that one. I told you.",
      "duration": 1.94,
      "file": "f58484cccf41a7b6.mp3"
    },
    {
      "id": "80386b410ffeb2a1",
      "text": "I wrote this one down.",
      "duration": 1.58,
      "file": "80386b410ffeb2a1.mp3"
    }
  ]
}
